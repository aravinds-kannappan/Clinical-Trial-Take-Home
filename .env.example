# Optional. Without it the deterministic rule-based planner is used.
OPENAI_API_KEY=
# Any OpenAI model that supports structured outputs. Tested: gpt-4.1, gpt-4.1-mini, gpt-5-mini.
LLM_MODEL=gpt-4.1
# Optional OpenAI-compatible endpoint override.
OPENAI_BASE_URL=
# ClinicalTrials.gov client tuning (defaults shown)
CTGOV_PAGE_SIZE=1000
DEFAULT_MAX_TRIALS=2000
DEFAULT_CITATIONS_PER_DATUM=25
